# Конфигурация системы анализа скриншотов

# PostgreSQL настройки
DB_USER=admin
DB_PASSWORD=changeme_please
DB_HOST=postgres
DB_PORT=5432
DB_NAME=screenshot_analytics

# Тип БД: postgresql или sqlite
DB_TYPE=postgresql

# Генерация хеша пароля для администратора дашборда:
# python -c "import hashlib; print(hashlib.sha256('YourPassword'.encode()).hexdigest())"

ADMIN_PASSWORD_HASH=
AUTH_SALT=change_this_to_random_string_for_security

# Google Sheets интеграция
GOOGLE_SERVICE_ACCOUNT_FILE=/app/config/service_account.json
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_NAME=Лист1

# Настройки OCR
# Выбор движка: TESSERACT или EASYOCR
OCR_ENGINE=TESSERACT

# Параметры Tesseract
TESSERACT_LANG=rus+eng

# Параметры EasyOCR
EASYOCR_MIN_CONFIDENCE=0.3  # Минимальный confidence для текста (0.0-1.0)

# OCR cache и метрики
OCR_CACHE_ENABLED=true
OCR_CACHE_TTL_SECONDS=86400
OCR_CACHE_MAX_ITEMS=1000
OCR_CACHE_FILE=/app/storage/ocr_cache.json

# Общие настройки OCR
BATCH_SIZE=10
PROCESSING_INTERVAL=60

# Настройки data-collector
UPLOAD_DIR=/app/incoming
SCREENSHOTS_DIR=/app/storage/screenshots
SCAN_INTERVAL_SECONDS=300

# Уровень логирования
LOG_LEVEL=INFO
